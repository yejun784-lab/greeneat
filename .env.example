# 본인 Supabase 프로젝트의 값으로 채워주세요
# supabase.com → 프로젝트 → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# 토스페이먼츠 (tosspayments.com → 개발자센터 → 내 상점)
# 테스트: test_ck_... / test_sk_...  |  라이브: live_ck_... / live_sk_...
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# Resend 이메일 (resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=GreenEat <noreply@yourdomain.com>

# 사이트 URL (배포 후 실제 URL로 변경)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
